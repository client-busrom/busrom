# Payload CMS Production Dockerfile
FROM node:20-bookworm AS base

# ============ Builder Stage ============
FROM base AS builder
WORKDIR /app

# Copy root package files for monorepo
COPY package.json package-lock.json ./

# Copy patches directory from root for patch-package
COPY patches ./patches

# Copy all workspace package.json files (required for npm ci in monorepo)
COPY payload-cms/package.json ./payload-cms/package.json
COPY web/package.json ./web/package.json

# Install ALL dependencies from root (monorepo)
RUN npm ci

# Copy payload-cms source code after install
COPY payload-cms ./payload-cms

# Build payload-cms
WORKDIR /app/payload-cms
RUN npm run build

# ============ Runner Stage ============
FROM base AS runner
WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs payloaduser

# Copy built application from builder
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/.next ./.next
COPY --from=builder --chown=payloaduser:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/package.json ./package.json
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/next.config.mjs ./next.config.mjs
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/payload.config.ts ./payload.config.ts
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/src ./src
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=payloaduser:nodejs /app/payload-cms/public ./public

# Copy startup script, CSS loader, and migration cleanup script
COPY --chown=payloaduser:nodejs payload-cms/start-payload.sh ./start-payload.sh
COPY --chown=payloaduser:nodejs payload-cms/css-loader.mjs ./css-loader.mjs
COPY --chown=payloaduser:nodejs payload-cms/css-loader-hooks.mjs ./css-loader-hooks.mjs
COPY --chown=payloaduser:nodejs payload-cms/clear-dev-migrations.mjs ./clear-dev-migrations.mjs
RUN chmod +x ./start-payload.sh

# Switch to non-root user
USER payloaduser

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3002/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start
CMD ["./start-payload.sh"]
