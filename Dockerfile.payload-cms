# Payload CMS Production Dockerfile
FROM node:20-bookworm AS base

# ============ Builder Stage ============
FROM base AS builder
WORKDIR /app

# Copy package files
COPY payload-cms/package.json payload-cms/package-lock.json ./

# Copy patches directory BEFORE npm ci so postinstall can apply them
COPY payload-cms/patches ./patches

# Install dependencies (postinstall will run patch-package)
RUN npm ci

# Copy source code
COPY payload-cms ./

# Build
RUN npm run build

# ============ Runner Stage ============
FROM base AS runner
WORKDIR /app/payload-cms

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs payloaduser

# Copy everything from builder
COPY --from=builder --chown=payloaduser:nodejs /app ./

# Copy startup script
COPY --chown=payloaduser:nodejs payload-cms/start-payload.sh ./start-payload.sh
RUN chmod +x ./start-payload.sh

# Switch to non-root user
USER payloaduser

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3002/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start
CMD ["./start-payload.sh"]
