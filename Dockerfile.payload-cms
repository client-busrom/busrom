# Payload CMS Production Dockerfile
FROM node:20-bookworm AS base

# ============ Builder Stage ============
FROM base AS builder
WORKDIR /app

# Copy root package files for monorepo
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./

# Copy patches directory from root for patch-package
COPY patches ./patches

# Copy all workspace package.json files (required for pnpm install in monorepo)
COPY payload-cms/package.json ./payload-cms/package.json
COPY web/package.json ./web/package.json

# Install ALL dependencies from root (monorepo)
RUN corepack enable pnpm && pnpm install --frozen-lockfile

# Copy payload-cms source code after install
COPY payload-cms ./payload-cms

# CDP dashboard URL baked into the admin UI (must be available at build time because
# it is referenced by a NEXT_PUBLIC_ variable in components/admin/CustomNav.tsx).
ARG NEXT_PUBLIC_CDP_DASHBOARD_URL=https://cdp.busromhouse.com/
ENV NEXT_PUBLIC_CDP_DASHBOARD_URL=$NEXT_PUBLIC_CDP_DASHBOARD_URL

# Build payload-cms
WORKDIR /app/payload-cms
RUN pnpm run build

# Deploy isolated workspace
WORKDIR /app
RUN pnpm deploy --filter busrom-payload-cms --prod /app/out
# Ensure .next is copied (pnpm deploy might ignore it due to .gitignore)
RUN cp -r /app/payload-cms/.next /app/out/.next

# ============ Runner Stage ============
FROM base AS runner
WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002

# Create non-root user
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs payloaduser

# Copy isolated workspace from builder
COPY --from=builder --chown=payloaduser:nodejs /app/out ./

# Copy startup script, CSS loader, and migration cleanup script
COPY --chown=payloaduser:nodejs payload-cms/start-payload.sh ./start-payload.sh
COPY --chown=payloaduser:nodejs payload-cms/css-loader.mjs ./css-loader.mjs
COPY --chown=payloaduser:nodejs payload-cms/css-loader-hooks.mjs ./css-loader-hooks.mjs
COPY --chown=payloaduser:nodejs payload-cms/clear-dev-migrations.mjs ./clear-dev-migrations.mjs
RUN chmod +x ./start-payload.sh

# Switch to non-root user
USER payloaduser

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3002/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start
CMD ["./start-payload.sh"]
