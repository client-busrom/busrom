# Database
DATABASE_URI=postgresql://busrom_dev:busrom_dev_password@localhost:5433/busrom_dev
# For production: postgresql://user:password@host:5432/database

# Payload
PAYLOAD_SECRET=your-super-secret-key-change-in-production

# S3 Storage
S3_BUCKET_NAME=busrom-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# CDN (CloudFront)
CDN_DOMAIN=your-cloudfront-domain.cloudfront.net

# MinIO (Local Development)
USE_MINIO=true
S3_ENDPOINT=http://localhost:9000

# App URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
