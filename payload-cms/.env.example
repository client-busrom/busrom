# Database
DATABASE_URI=postgresql://busrom_dev:busrom_dev_password@localhost:5433/busrom_dev
# For production: postgresql://user:password@host:5432/database

# Payload
PAYLOAD_SECRET=your-super-secret-key-change-in-production

# Auth cookie domain - share the payload-token cookie across subdomains.
# Use a leading dot so the cookie is visible to all subdomains.
# Local: .busrom.local  |  Production: .busromhouse.com
PAYLOAD_COOKIE_DOMAIN=.busromhouse.com

# Payload CMS base URL (used by CDP/Superset SSO redirects and cookie sharing).
# Local: http://localhost:3002  |  Production: https://cms.busromhouse.com
PAYLOAD_URL=https://cms.busromhouse.com

# S3 Storage
S3_BUCKET_NAME=busrom-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# CDN (CloudFront)
CDN_DOMAIN=your-cloudfront-domain.cloudfront.net

# MinIO (Local Development)
USE_MINIO=true
S3_ENDPOINT=http://localhost:9000

# App URL
NEXT_PUBLIC_SERVER_URL=https://cms.busromhouse.com

# CDP (Customer Data Platform) Superset dashboard URL.
# This is baked into the Payload admin UI at build time (NEXT_PUBLIC_).
# Local: http://localhost:3003/  |  Production: https://cdp.busromhouse.com/
NEXT_PUBLIC_CDP_DASHBOARD_URL=https://cdp.busromhouse.com/

# Revalidation
REVALIDATE_SECRET=your-revalidation-secret-token

# Google Indexing API
# Paste the entire JSON content from your Google Cloud Service Account key file on a single line
GOOGLE_INDEXING_CREDENTIALS='{"type":"service_account","project_id":"cogent-wall-484202-c8","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"indexing-bot@cogent-wall-484202-c8.iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# IndexNow API Key (Bing/Yandex/etc.)
# Generate a random string, e.g. openssl rand -hex 32
# It will be hosted at /{INDEXNOW_KEY}.txt on the web domain for verification
INDEXNOW_KEY=b6256569b4890a3337af5aa7dcff8cb468c6097749eecb359184ed870a290f1e
