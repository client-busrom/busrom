{
  "name": "busrom-payload-cms",
  "version": "1.0.0",
  "description": "Busrom CMS powered by Payload",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3002",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3002",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:types": "payload generate:types",
    "generate:schema": "payload-graphql generate:schema",
    "migrate:keystone": "npx tsx scripts/migrate-from-keystone.ts",
    "seed:homepage": "npx tsx scripts/seed-homepage.ts",
    "seed:series-intro": "npx tsx scripts/seed-series-intro-items.ts",
    "seed:all-homepage": "npx tsx scripts/seed-all-homepage.ts",
    "import:keystone": "npx tsx scripts/import-from-keystone.ts",
    "import:series-categories": "npx tsx scripts/import-product-series-categories.ts",
    "import:media": "npx tsx scripts/migrate-media-from-keystone-enhanced.ts",
    "import:media:s3": "npx tsx scripts/import-media-from-aws-s3.ts",
    "deploy:production": "npx tsx scripts/deploy-production-data.ts",
    "parse:media-metadata": "npx tsx scripts/parse-media-metadata.ts",
    "postinstall": "patch-package || true"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.994.0",
    "@aws-sdk/client-s3": "^3.982.0",
    "@aws-sdk/client-sesv2": "^3.982.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payloadcms/db-postgres": "3.69.0",
    "@payloadcms/graphql": "3.69.0",
    "@payloadcms/next": "3.69.0",
    "@payloadcms/plugin-seo": "3.69.0",
    "@payloadcms/richtext-lexical": "3.69.0",
    "@payloadcms/storage-s3": "3.69.0",
    "@payloadcms/translations": "3.69.0",
    "@payloadcms/ui": "3.69.0",
    "@types/nodemailer": "^7.0.4",
    "browser-image-compression": "^2.0.2",
    "country-flag-icons": "^1.6.4",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "graphql": "^16.8.1",
    "libphonenumber-js": "^1.12.40",
    "lucide-react": "^0.561.0",
    "next": "^15.5.11",
    "nodemailer": "^7.0.11",
    "payload": "3.69.0",
    "payload-auditor": "^1.11.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "sharp": "^0.33.0",
    "speakeasy": "^2.0.0",
    "undici": "^7.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/speakeasy": "^2.0.10",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "npm:null@*"
  }
}
