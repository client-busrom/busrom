{
  "name": "busrom-payload-cms",
  "version": "1.0.0",
  "description": "Busrom CMS powered by Payload",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3002",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3002",
    "generate:types": "payload generate:types",
    "generate:schema": "payload-graphql generate:schema",
    "migrate:keystone": "npx tsx scripts/migrate-from-keystone.ts",
    "seed:homepage": "npx tsx scripts/seed-homepage.ts",
    "seed:series-intro": "npx tsx scripts/seed-series-intro-items.ts",
    "seed:all-homepage": "npx tsx scripts/seed-all-homepage.ts",
    "import:keystone": "npx tsx scripts/import-from-keystone.ts",
    "import:series-categories": "npx tsx scripts/import-product-series-categories.ts",
    "import:media": "npx tsx scripts/migrate-media-from-keystone-enhanced.ts",
    "deploy:production": "npx tsx scripts/deploy-production-data.ts",
    "parse:media-metadata": "npx tsx scripts/parse-media-metadata.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payloadcms/db-postgres": "^3.68.5",
    "@payloadcms/graphql": "^3.68.5",
    "@payloadcms/next": "^3.68.5",
    "@payloadcms/plugin-seo": "^3.68.5",
    "@payloadcms/richtext-lexical": "^3.68.5",
    "@payloadcms/storage-s3": "^3.68.5",
    "@payloadcms/translations": "^3.68.5",
    "@payloadcms/ui": "^3.68.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "graphql": "^16.8.1",
    "lucide-react": "^0.561.0",
    "next": "^15.0.0",
    "payload": "^3.68.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.0",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/speakeasy": "^2.0.10",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
