{
  "name": "busrom-project",
  "version": "1.0.0",
  "private": true,
  "description": "Busrom - International B2B Glass Hardware Product Website",
  "workspaces": [
    "payload-cms",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:cms\" \"npm run dev:web\"",
    "dev:cms": "npm run dev --workspace=payload-cms",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "build:cms": "npm run build --workspace=payload-cms",
    "build:web": "npm run build --workspace=web",
    "postinstall": "npx --no patch-package || true"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "embla-carousel-auto-scroll": "^8.6.0"
  }
}
