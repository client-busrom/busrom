{
  "name": "busrom-project",
  "version": "1.0.0",
  "private": true,
  "description": "Busrom - International B2B Glass Hardware Product Website",
  "workspaces": [
    "payload-cms",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:cms\" \"pnpm run dev:web\"",
    "dev:cms": "pnpm --filter payload-cms run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r run build",
    "build:cms": "pnpm --filter payload-cms run build",
    "build:web": "pnpm --filter web run build",
    "dev:cdp": "cd cdp && npm run dev",
    "build:cdp": "cd cdp && npm run build",
    "type-check:cdp": "cd cdp && npm run type-check",
    "etl:run": "cd cdp && npm run etl:run",
    "etl:run:today": "cd cdp && npm run etl:run:today",
    "postinstall": "npx --no patch-package || true"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "embla-carousel-auto-scroll": "^8.6.0"
  },
  "packageManager": "pnpm@9.12.0"
}
