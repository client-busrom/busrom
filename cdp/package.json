{
  "name": "@busrom/cdp",
  "version": "1.0.0",
  "private": true,
  "description": "Busrom CDP - Customer Data Platform Analytics",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3003 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "etl:run": "tsx src/jobs/run-etl.ts",
    "etl:run:today": "tsx src/jobs/run-etl.ts $(date +%Y-%m-%d)"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "geoip-lite": "^1.4.10",
    "jose": "^5.9.6",
    "lucide-react": "^0.552.0",
    "next": "^15.5.11",
    "pg": "^8.16.3",
    "postcss": "^8.4.49",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
