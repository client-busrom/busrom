# CDP Environment Variables

# ------------------------------------------------------------------------------
# Database (PostgreSQL - same server as CMS, different database)
# ------------------------------------------------------------------------------
# Production: postgresql://user:password@host:5432/busrom_cdp?sslmode=require
DATABASE_URL=postgresql://busrom:busrom_dev_password@localhost:5432/busrom_cdp

# ------------------------------------------------------------------------------
# Payload CMS integration (SSO / shared JWT secret)
# ------------------------------------------------------------------------------
# PAYLOAD_URL is the canonical CMS URL used by CDP middleware for redirects and
# JWT validation.  It replaces the older PAYLOAD_CMS_URL name.
# Local: http://localhost:3002  |  Production: https://cms.busromhouse.com
PAYLOAD_URL=https://cms.busromhouse.com

# PAYLOAD_SECRET must match the value configured in Payload CMS. It is used to
# verify the payload-token cookie. Minimum 32 characters in production.
PAYLOAD_SECRET=CHANGE_ME_TO_A_SECURE_SECRET_AT_LEAST_32_CHARS

# Cookie domain shared with Payload CMS so the payload-token cookie is visible
# to CDP on subdomains. Use a leading dot for subdomain sharing.
# Local: .busrom.local  |  Production: .busromhouse.com
PAYLOAD_COOKIE_DOMAIN=.busromhouse.com

# ------------------------------------------------------------------------------
# CDP Service
# ------------------------------------------------------------------------------
CDP_PORT=3003
NODE_ENV=development

# Public endpoint exposed to web frontends. This is consumed by the Web build as
# NEXT_PUBLIC_CDP_ENDPOINT.
# Local: http://localhost:3003  |  Production: https://cdp.busromhouse.com
NEXT_PUBLIC_CDP_ENDPOINT=https://cdp.busromhouse.com

# Whether to anonymize all IPs before writing analytics events.
CDP_ANONYMIZE_IP=false

# ETL API Key used by internal cron/CI to trigger ETL jobs.
ETL_API_KEY=CHANGE_ME_ETL_API_KEY

# ------------------------------------------------------------------------------
# Superset SSO (when running the Superset image from docker/superset)
# ------------------------------------------------------------------------------
# URI of the Payload CMS PostgreSQL database so Superset can look up users/roles.
# Production: postgresql://user:password@host:5432/busrom_cms?sslmode=require
PAYLOAD_DB_URI=postgresql://busrom:busrom_dev_password@localhost:5432/busrom_cms

# Comma-separated Payload role codes allowed to access Superset.
PAYLOAD_SSO_ALLOWED_ROLES=admin,editor,analytics

# Default Superset role assigned when no mapping matches.
PAYLOAD_SSO_DEFAULT_ROLE=Gamma

# Optional JSON mapping from Payload role code to Superset role name(s).
# PAYLOAD_SSO_ROLE_MAPPING={"admin":["Admin"],"editor":["Alpha"],"analytics":["Gamma"]}
