# =================================
# Web Application Environment Variables
# =================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git!

# ----------------------------------
# Database
# ----------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/busrom_dev"

# ----------------------------------
# API & GraphQL
# ----------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3000/api/graphql"
NEXT_PUBLIC_GRAPHQL_ENDPOINT="http://localhost:3000/api/graphql"

# ----------------------------------
# Session & Authentication
# ----------------------------------
SESSION_SECRET="your-super-secret-session-key-change-this"

# ----------------------------------
# Cloudinary (Image Storage)
# ----------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ----------------------------------
# Environment
# ----------------------------------
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"

# ----------------------------------
# CMS Configuration
# ----------------------------------
NEXT_PUBLIC_CMS_URL="http://localhost:3000"
CMS_GRAPHQL_URL="http://localhost:3000/api/graphql"

# ----------------------------------
# S3 / MinIO (File Upload Storage)
# ----------------------------------
# Local Development (MinIO)
S3_BUCKET_NAME="busrom-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
USE_MINIO="true"
S3_ENDPOINT="http://localhost:9000"

# Production (AWS S3)
# S3_BUCKET_NAME="busrom-media"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-aws-access-key"
# S3_SECRET_ACCESS_KEY="your-aws-secret-key"
# USE_MINIO="false"
# CDN_DOMAIN="d123456789.cloudfront.net"

# ----------------------------------
# CDN Configuration
# ----------------------------------
NEXT_PUBLIC_CDN_DOMAIN="http://localhost:8080"

# ----------------------------------
# Revalidation
# ----------------------------------
REVALIDATE_SECRET="your-revalidation-secret-token"

# ----------------------------------
# CDP Tracker (Analytics)
# ----------------------------------
# NEXT_PUBLIC_ variables are baked into the client bundle at build time and MUST
# be passed as Docker build args in CI/CD (see Dockerfile.web).
# Local: http://localhost:3003/api/analytics/track
# Production: https://cdp.busromhouse.com/api/analytics/track
NEXT_PUBLIC_CDP_ENDPOINT="https://cdp.busromhouse.com/api/analytics/track"
NEXT_PUBLIC_CDP_API_KEY=""
NEXT_PUBLIC_CDP_DEBUG="false"

# ----------------------------------
# Tawk.to Chat (Optional)
# ----------------------------------
# 100% Free, unlimited agents & conversations
# Get your Property ID & Widget ID from Tawk.to Dashboard
NEXT_PUBLIC_TAWK_PROPERTY_ID="your-tawk-property-id"
NEXT_PUBLIC_TAWK_WIDGET_ID="your-tawk-widget-id"
